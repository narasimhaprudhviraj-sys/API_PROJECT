            },
            "url": { "raw": "{{baseUrl}}/students/1/academics", "host": ["{{baseUrl}}"], "path": ["students", "1", "academics"] }
          }
        }
      ]
    },
    {
      "name": "10. Course Registration & Drop APIs",
      "item": [
        {
          "name": "Register for Eligible Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"courseId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/registrations", "host": ["{{baseUrl}}"], "path": ["registrations"] }
          }
        },
        {
          "name": "Get Student Registrations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/registrations/student/1", "host": ["{{baseUrl}}"], "path": ["registrations", "student", "1"] }
          }
        },
        {
          "name": "Drop Course (Within Window, Preserves History)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/registrations/1/drop/1", "host": ["{{baseUrl}}"], "path": ["registrations", "1", "drop", "1"] }
          }
        }
      ]
    },
    {
      "name": "11. Academic Business Rule Validations",
      "item": [
        {
          "name": "Reject Student Altering Minor Stream (403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minorStreamId\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/students/1/self", "host": ["{{baseUrl}}"], "path": ["students", "1", "self"] }
          }
        },
        {
          "name": "Reject Registering Course of Different Branch (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"courseId\": 7\n}"
            },
            "url": { "raw": "{{baseUrl}}/registrations", "host": ["{{baseUrl}}"], "path": ["registrations"] }
          }
        }
      ]
    },
    {
      "name": "12. Dashboard & Stats APIs",
      "item": [
        {
          "name": "Get Admin Dashboard Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Stats structure is valid', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('totalStudents');",
                  "    pm.expect(json).to.have.property('totalCourses');",
                  "    pm.expect(json).to.have.property('totalFaculty');",
                  "    pm.expect(json).to.have.property('totalBranches');",
                  "    pm.expect(json).to.have.property('totalMinorStreams');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          }
        }
      ]
    },
    {
      "name": "13. Audit & Logging APIs",
      "item": [
        {
          "name": "Get Paginated Registrations Audit",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/registrations/page?page=0&size=10&sort=registrationDate,desc", "host": ["{{baseUrl}}"], "path": ["admin", "registrations", "page"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }, { "key": "sort", "value": "registrationDate,desc" }] }
          }
        },
        {
          "name": "Get Paginated Students Audit",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/students/page?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["admin", "students", "page"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
          }
        }
      ]
    }
  ]
}
