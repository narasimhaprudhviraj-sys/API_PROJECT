              "raw": "{\n  \"courseCode\": \"MAD302\",\n  \"courseName\": \"Cross-Platform Mobile Dev\",\n  \"description\": \"Flutter and Dart multiplatform development.\",\n  \"credits\": 3,\n  \"maxSeats\": 30,\n  \"availableSeats\": 30,\n  \"duration\": \"12 Weeks\",\n  \"status\": \"ACTIVE\",\n  \"branchId\": 1,\n  \"minorStreamId\": 1,\n  \"semesterId\": 1,\n  \"facultyId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] }
          }
        }
      ]
    },
