{
  "info": {
    "_postman_id": "c71a3994-b258-48fe-89dc-0fc253b70e5b",
    "name": "Online Course Registration Management System - Complete API Collection",
    "description": "Production-ready Postman collection covering all 13 REST API modules: Authentication (JWT), Branches, Minor Streams, Sections, Faculty, Semesters, Registration Windows, Courses, Students, Registrations, Academic Rule Validations, Dashboard Stats, and Audit Queries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "facultyToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & JWT APIs",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "}",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Role is ADMIN', function () { pm.expect(jsonData.role).to.eql('ADMIN'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@college.edu\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/login", "host": ["{{baseUrl}}"], "path": ["admin", "login"] }
          }
        },
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('studentToken', jsonData.token);",
                  "}",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Role is STUDENT', function () { pm.expect(jsonData.role).to.eql('STUDENT'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"akhil@gmail.com\",\n  \"password\": \"12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/students/login", "host": ["{{baseUrl}}"], "path": ["students", "login"] }
          }
        },
        {
          "name": "Faculty Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('facultyToken', jsonData.token);",
                  "}",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Role is FACULTY', function () { pm.expect(jsonData.role).to.eql('FACULTY'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ravi.kumar@college.edu\",\n  \"password\": \"faculty123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/faculty/login", "host": ["{{baseUrl}}"], "path": ["admin", "faculty", "login"] }
          }
        }
      ]
    },
    {
      "name": "02. Branch Management APIs",
      "item": [
        {
          "name": "Get All Branches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/branches", "host": ["{{baseUrl}}"], "path": ["branches"] }
          }
        },
        {
          "name": "Get Active Branches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/branches/active", "host": ["{{baseUrl}}"], "path": ["branches", "active"] }
          }
        },
        {
          "name": "Create Branch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchCode\": \"MECH\",\n  \"branchName\": \"Mechanical Engineering\",\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/branches", "host": ["{{baseUrl}}"], "path": ["branches"] }
          }
        },
        {
          "name": "Toggle Branch Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/branches/1/toggle", "host": ["{{baseUrl}}"], "path": ["branches", "1", "toggle"] }
          }
        }
      ]
    },
    {
