            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Semester 4 Special Window\",\n  \"semesterId\": 2,\n  \"startDateTime\": \"2026-10-01T00:00:00\",\n  \"endDateTime\": \"2026-10-25T23:59:59\",\n  \"status\": \"OPEN\",\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/registration-windows", "host": ["{{baseUrl}}"], "path": ["registration-windows"] }
          }
        }
      ]
    },
    {
